#!/usr/bin/env bash
# Runs a command inside the test environment `discamb`, with the runtime
# library path (and, for BUILD_KIND=sycl, the SYCL device selector) it needs.
#   usage: env-exec <command> [args...]
set -euo pipefail

prefix="$MAMBA_ROOT_PREFIX/envs/discamb"
libs="$prefix/lib"
if [ "$BUILD_KIND" = sycl ]; then
    libs="$DPCPP_ROOT/lib:$libs"
    export ONEAPI_DEVICE_SELECTOR="${TEST_BACKEND}:*"
fi
export LD_LIBRARY_PATH="$libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec micromamba run -p "$prefix" "$@"
